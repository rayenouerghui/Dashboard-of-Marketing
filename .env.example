# Authentication
SESSION_SECRET=your-secret-key-at-least-32-characters-long
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=$2a$12$...
MEMBER_ACCESS_CODES=code1,code2,code3

# Cron Job Protection
CRON_SECRET=your-cron-secret-at-least-16-characters

# Google Sheets Integration
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Ranking tab / person-name override (priority: index, then header, then allowlist)
RANKING_SHEET_TAB=Physical Data
RANKING_NAME_COLUMN_INDEX=18
RANKING_NAME_COLUMN="Member Name"

# Optional: Separate spreadsheet IDs for OGV and OGT
# OPPORTUNITY_OGV_SPREADSHEET_ID=
# OPPORTUNITY_OGT_SPREADSHEET_ID=

# Upstash Redis for rate limiting (required for production)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
